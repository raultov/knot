varnishtest "Error VCL test"

server s1 {
    rxreq
    txresp
} -start

varnish v1 -errvcl "expected compilation failure" {
    this is not valid vcl @@@@!!!
    syntaX error here
} -start

client c1 {
    txreq -url "/"
    rxresp
} -run
